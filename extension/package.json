{
  "name": "tigerlens",
  "displayName": "TigerLens",
  "version": "1.0.0",
  "description": "Real-time GraphRAG browser extension with side-by-side RAG comparison and visual screenshot extraction",
  "author": "livu",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.460.0",
    "plasmo": "^0.89.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  },
  "manifest": {
    "permissions": [
      "sidePanel",
      "activeTab",
      "tabs",
      "storage"
    ],
    "host_permissions": [
      "http://localhost:8741/*",
      "<all_urls>"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}