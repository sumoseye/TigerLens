{
  "name": "browsegraph-tigerlens",
  "displayName": "BrowseGraph & TigerLens",
  "version": "1.0.0",
  "description": "Real-time GraphRAG browser extension with side-by-side RAG comparison and visual screenshot extraction",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.0",
    "@xyflow/react": "^12.3.6",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "plasmo": "0.89.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "5.7.2"
  },
  "manifest": {
    "permissions": [
      "sidePanel",
      "activeTab",
      "tabs",
      "storage"
    ],
    "host_permissions": [
      "http://localhost:8741/*",
      "<all_urls>"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.35.4",
    "@parcel/watcher-darwin-arm64": "^2.6.0"
  }
}
